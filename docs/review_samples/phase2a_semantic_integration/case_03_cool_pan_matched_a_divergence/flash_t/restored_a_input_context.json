dc9a18a8b29f6", "consumed_h_id": "h-32ec82c80990628e", "evidence_id": "evidence-2625d853672cb7e2", "source_memory_ids": [], "task_id": "pick_clean_then_place_in_recep-Pan-None-CounterTop-10/trial_T20190908_032543_712058"}, "omitted_sections": ["prior_comparison_evidence.evidence_basis", "prior_comparison_evidence.binding.a_artifact_ref"], "operation": "ADD"}, "scope": "ALFWorld kitchen tasks where the target object is a cookware item (e.g., pan, pot)."}, {"guidance": "After acquiring the target object, navigate to a fridge, open it if closed, place the object inside to cool it, then retrieve it and transport it to the destination.", "memory_id": "established-cool-then-place-routine", "prior_comparison_evidence": null, "scope": "ALFWorld tasks requiring cooling an object before final placement."}, {"guidance": "After acquiring the target object, navigate to a microwave, open it if closed, put the object inside, close it, and execute heating. Then retrieve the heated object and place it on the final receptacle.", "memory_id": "established-heat-then-place-routine", "prior_comparison_evidence": null, "scope": "ALFWorld tasks requiring heating an object before final placement."}, {"guidance": "When searching for perishable food items like tomatoes, lettuce, or potatoes in kitchens, prioritize inspecting open surfaces (countertops, shelves) before closed storage units (cabinets, drawers, fridge). This avoids the action cost of opening/closing containers and can yield very fast acquisition if the item is on a visible open surface. Note that if the target is not on the first few open surfaces, the fallback to closed storage may still require many steps; consider integrating spatial proximity into the open-surface traversal order if available. Additionally, be aware that targets may occasionally appear in non-standard locations such as garbage cans, which should be checked if standard open surfaces and primary storage are empty.", "lineage": ["artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/08-059972eb9c84/T/a", "artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/12-4612230d216e/T/a", "artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/15-c6b8fdfddbd0/T/a", "artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/19-8bbd1c1dad4e/T/a", "artifacts/exploratory_memory_mvp/phase1d-long-horizon-v1-20260921-ac0bb2b/tasks/034-96138b52c513/T/a", "artifacts/exploratory_memory_mvp/phase1d-long-horizon-v1-20260921-ac0bb2b/tasks/043-2077d9ed59d9/T/a"], "memory_id": "established-3134b2ab1f0a162d", "prior_comparison_evidence": {"binding": {"comparison_id": null, "consumed_h_id": null, "evidence_id": "evidence-4aac333b7f9b369a", "source_memory_ids": ["established-3134b2ab1f0a162d"], "task_id": "pick_cool_then_place_in_recep-Tomato-None-Microwave-10/trial_T20190909_102608_318800"}, "omitted_sections": ["prior_comparison_evidence.evidence_basis", "prior_comparison_evidence.binding.a_artifact_ref"], "operation": "REFINE"}, "scope": "ALFWorld kitchen tasks requiring cooling/heating perishable food items (tomato, apple, lettuce, potato, egg, etc.) where the target location is unknown."}, {"guidance": "When searching for condiments (e.g., saltshakers, peppershakers) in kitchen environments, prioritize inspecting open surfaces like countertops AND shelves before checking closed storage units (cabinets, drawers). Ensure the traversal of open surfaces includes all types (countertops, shelves, tables) systematically to avoid missing targets located on less-frequently-checked open surfaces like shelves. Note that if the target is not on the first few open surfaces checked, the fallback to closed storage may still incur significant action costs; consider integrating spatial proximity or visual cues into the open-surface traversal order if available.", "lineage": ["artifacts/exploratory_memory_mvp/phase1d-long-horizon-v1-20260921-ac0bb2b/tasks/033-1b5cbde4290e/T/a", "artifacts/exploratory_memory_mvp/phase1d-long-horizon-v1-20260921-ac0bb2b/tasks/037-ae8d6504429e/T/a", "artifacts/exploratory_memory_mvp/phase1d-long-horizon-v1-20260921-ac0bb2b/tasks/041-9697b5784132/T/a"], "memory_id": "established-3e752a4011c8686b", "prior_comparison_evidence": {"binding": {"comparison_id": "comparison-ff98a0cc8b6e08de", "consumed_h_id": "h-d70515b60755f8b2", "evidence_id": "evidence-5a638917ba9abe82", "source_memory_ids": ["established-3e752a4011c8686b"], "task_id": "pick_and_place_simple-PepperShaker-None-Drawer-10/trial_T20190906_184021_215264"}, "omitted_sections": ["prior_comparison_evidence.evidence_basis", "prior_comparison_evidence.binding.a_artifact_ref"], "operation": "REFINE"}, "scope": "ALFWorld kitchen tasks where the target object is a condiment and both open surfaces and closed storage units are visible."}, {"guidance": "After acquiring the target object, locate a sinkbasin, navigate to it, and clean the carried object using an available sinkbasin. Then carry the clean object to the requested destination and place it.", "memory_id": "established-clean-then-place-routine", "prior_comparison_evidence": null, "scope": "ALFWorld tasks requiring cleaning an object before final placement."}, {"guidance": "For decorative objects in living rooms, prioritize inspection of open display surfaces (shelves, sidetables, dressers, armchairs) before navigating to and opening closed storage units (cabinets, drawers). If the target is not found on initial open surfaces, proceed to systematically inspect remaining open surfaces (like dressers) before exhausting closed storage options, as decorative items are more likely to be displayed openly than stored away.", "lineage": ["artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/21-10cb7cc8f0ce/T/a"], "memory_id": "established-ea32a436454c1c0a", "prior_comparison_evidence": {"binding": {"comparison_id": "comparison-dd8b81323c9ba313", "consumed_h_id": "h-52a4ca921b1