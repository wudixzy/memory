lished-3134b2ab1f0a162d", "established-3e752a4011c8686b", "established-87d1cd11cd066c18", "established-cool-then-place-routine", "established-daf551775986f639", "established-ea32a436454c1c0a"]}, "pre_task_established_memory": [{"guidance": "After acquiring the target object, locate a sinkbasin, navigate to it, and clean the carried object using an available sinkbasin. Then carry the clean object to the requested destination and place it.", "memory_id": "established-clean-then-place-routine", "prior_comparison_evidence": null, "scope": "ALFWorld tasks requiring cleaning an object before final placement."}, {"guidance": "After acquiring the target object, navigate to a microwave, open it if closed, put the object inside, close it, and execute heating. Then retrieve the heated object and place it on the final receptacle.", "memory_id": "established-heat-then-place-routine", "prior_comparison_evidence": null, "scope": "ALFWorld tasks requiring heating an object before final placement."}, {"guidance": "When searching for cloth items (towel, handtowel, cloth) in bathroom environments, prioritize inspecting open surfaces like countertops and sink basins before checking closed storage units (cabinets, drawers). This semantic prioritization often yields faster acquisition than arbitrary spatial ordering or exhaustive type grouping, as it avoids the action cost of opening/closing containers when the item is likely on a surface.", "lineage": ["artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/02-e5fbb2d17967/T/a", "artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/04-9b58f11df123/T/a", "artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/06-370500a098b6/T/a", "artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/07-5582b1da75fa/T/a", "artifacts/exploratory_memory_mvp/phase1c-scale-pilot-v1-20260921-60c2474/tasks/11-4895b5983421/T/a", "artifacts/exploratory_memory_mvp/