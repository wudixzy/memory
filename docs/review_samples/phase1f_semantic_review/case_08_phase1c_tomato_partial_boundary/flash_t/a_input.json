        "adaptive_policy": "Select the nearest or first-listed open surface from the entry observation. Navigate to it. Use 'look' to check for the target. If the target is present, take it. If not, repeat for the next open surface. Do not enter closed storage until all open surfaces are checked.",
        "capability_requirements": [
          "go to <open_surface>",
          "look"
        ],
        "evidence_goal": "Count the number of navigation and look actions required to locate the target object compared to a baseline that starts at the fridge.",
        "local_function": "Search for the target object among visible receptacles.",
        "realization_pattern": "Open-surface-first scan: traverse all visible open surfaces (countertops, shelves) before any closed storage units (fridges, cabinets, drawers).",
        "required_downstream_state": "Target object is identified and taken into inventory.",
        "stop_conditions": [
          "Target object is located on an open surface.",
          "All visible open surfaces have been inspected without finding the target."
